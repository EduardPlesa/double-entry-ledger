{
  "name": "@ledger/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ledger/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.5",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "22.19.1",
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
