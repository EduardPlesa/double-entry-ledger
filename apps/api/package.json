{
  "name": "@ledger/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "checkpoint": "node --env-file-if-exists=../../.env --import tsx scripts/checkpoint.ts",
    "perf:seed": "node --env-file-if-exists=../../.env --import tsx scripts/seed-perf.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ledger/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "jose": "6.2.5",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "fast-check": "4.9.0",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
