# Every variable the application reads. The schema in apps/api/src/config.ts is the
# authority: it validates this set at boot and refuses to start on anything it does not
# recognise as valid. Copy this file to .env, which is gitignored.
#
# Node loads .env itself (--env-file-if-exists in the package scripts), so a real
# environment variable always wins over a line in the file.

# Runtime connection. Uses ledger_app, which has SELECT + INSERT on entries and
# postings and has UPDATE/DELETE explicitly revoked. The application never gets a
# connection that is capable of mutating history.
DATABASE_URL=postgres://ledger_app:ledger_app_dev@localhost:5433/ledger

# Migration-only connection. Uses ledger_owner, which owns the schema. Only the
# migration CLI ever opens this. Keeping it separate is what makes the REVOKE above
# meaningful: if the app and the migrator shared a role, the app could re-grant itself
# UPDATE at runtime. Config rejects the two URLs naming the same role for that reason.
DATABASE_MIGRATION_URL=postgres://ledger_owner:ledger_owner_dev@localhost:5433/ledger

# Signs and verifies the 10-minute access token. Minimum 32 characters, no default: a
# secret with a fallback is a secret that eventually ships as the fallback.
#
#     openssl rand -base64 32
#
AUTH_JWT_SECRET=development-only-jwt-secret-not-for-anything-real

# Keys the HMAC that refresh tokens are stored under. Deliberately a different value from
# AUTH_JWT_SECRET - they protect different things, and one leaked value should not
# compromise both. Config refuses to start if the two match. Rotating this invalidates
# every refresh token at once, which is the point on the day it is needed.
AUTH_REFRESH_TOKEN_PEPPER=development-only-refresh-pepper-not-for-anything-real

# Optional; the defaults are shown. Omit them entirely and the application behaves the
# same way.
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10

# How the overdraft rule is kept true when two writers meet. `row-lock` takes an explicit
# FOR NO KEY UPDATE on the accounts an entry draws from and writers block; `serializable`
# runs at SERIALIZABLE with no explicit locks and retries on 40001, so writers abort instead.
# Both enforce the rule exactly, but they are not equivalent to a caller: nothing translates
# an exhausted 40001 into a domain error, so under `serializable` a contested withdrawal that
# `row-lock` would answer with a 422 ACCOUNT_OVERDRAWN instead exhausts its retries and comes
# back as a 500. See docs/adr/0004-concurrency-control.md for the numbers and the argument for
# the default.
# LEDGER_CONCURRENCY_STRATEGY=row-lock

# AUTH_JWT_ISSUER=ledger
# AUTH_JWT_AUDIENCE=ledger-api
# AUTH_ACCESS_TOKEN_TTL_SECONDS=600
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# argon2id cost. The defaults are OWASP's current minimum - 19 MiB, two passes, one lane.
# Lower them on a laptop if you must; do not lower them anywhere real.
# AUTH_ARGON2_MEMORY_COST_KIB=19456
# AUTH_ARGON2_TIME_COST=2
# AUTH_ARGON2_PARALLELISM=1

# The environment label in an API key (lk_dev_..., lk_test_..., lk_live_...) is derived
# from NODE_ENV and is deliberately not configurable: a key that says live while the
# process that minted it is in development is a key someone trusts in the wrong place.

# Every secret and password in this file is development-only. The database passwords match
# docker/initdb/00-bootstrap-roles.sql; the two above are placeholders that are long enough
# to pass validation and worthless everywhere else.
